{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/external-agent-gateway.schema.json",
  "title": "External Agent Gateway JSONL Protocol",
  "type": "object",
  "required": ["request_id", "message"],
  "properties": {
    "protocol_version": { "type": "string", "const": "0.1" },
    "request_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
    "session_id": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "minLength": 1 },
    "material_path": { "type": "string", "minLength": 1 },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "content"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "content": { "type": "string", "minLength": 1 },
          "source_type": { "type": "string" },
          "source_owner": { "type": "string" },
          "source_time": { "type": "string" },
          "is_complete": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "debug": { "type": "boolean" },
    "client": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
