# 本地 Runtime 配置
PROJECT_ROOT=./context-workspace
RUNTIME_DIR=./runtime

# 模型配置。默认 workspace 不调用外部模型。
MODEL_PROVIDER=deepseek

# DeepSeek（OpenAI 兼容 Chat Completions API）
DEEPSEEK_API_KEY=你的_DEEPSEEK_API_KEY
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI Responses API
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=你的账号可用模型 ID
# OPENAI_BASE_URL=https://api.openai.com/v1

# Kimi：OpenAI 兼容 Chat Completions API
# MODEL_PROVIDER=kimi
# KIMI_API_KEY=你的 Kimi Key
# KIMI_MODEL=moonshot-v1-8k
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# Claude：Anthropic Messages API
# MODEL_PROVIDER=claude
# ANTHROPIC_API_KEY=你的 Anthropic Key
# CLAUDE_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# 其他 OpenAI 兼容服务
# MODEL_PROVIDER=compatible
# MODEL_API_KEY=你的 Key
# MODEL_ID=服务商模型 ID
# MODEL_BASE_URL=https://服务商域名/v1

# 所有真实模型共享的超时配置
# MODEL_TIMEOUT_MS=120000

# GitHub 仓库（脱敏后填写）
# GITHUB_REPO=https://github.com/<your-username>/context-delivery-agent
