{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prd-thinking-output",
  "type": "object",
  "additionalProperties": false,
  "required": ["background_card", "decision_ledger", "writable_assessment"],
  "properties": {
    "background_card": {
      "type": "object",
      "required": ["materials_read", "current_state", "problem", "target_users", "user_scenarios", "upstream_dependencies", "downstream_impacts", "confirmed_scope", "confirmed_out_of_scope", "conflicts", "missing_information", "source_refs", "material_classification"],
      "properties": {
        "material_classification": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_ref", "category", "usage", "adoption"],
            "properties": {
              "source_ref": {"type": "string"},
              "category": {
                "enum": ["stable_context", "historical_prd", "material_analysis", "user_material", "decision_ledger", "external_standard"]
              },
              "usage": {"type": "string"},
              "adoption": {
                "enum": ["default_adopt", "reference_only", "needs_confirmation", "verify_version"]
              },
              "risk": {"type": "string"}
            }
          }
        }
      }
    },
    "decision_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision_id", "question", "evidence", "recommended_option", "alternative_options", "impact_scope", "status", "is_blocking", "human_decision"],
        "properties": {
          "decision_id": {"type": "string"},
          "question": {"type": "string"},
          "evidence": {"type": "array"},
          "recommended_option": {"type": "string"},
          "alternative_options": {"type": "array", "items": {"type": "string"}},
          "impact_scope": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["CONFIRMED", "PENDING", "BLOCKED", "SUPERSEDED"]},
          "is_blocking": {"type": "boolean"},
          "human_decision": {"type": ["string", "null"]},
          "source_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "writable_assessment": {
      "type": "object",
      "required": ["status", "checks", "blockers", "priority_questions"],
      "properties": {
        "status": {"enum": ["READY", "NEEDS_CONFIRMATION", "BLOCKED"]},
        "checks": {"type": "object"},
        "blockers": {"type": "array"},
        "priority_questions": {"type": "array", "maxItems": 3}
      }
    }
  }
}
